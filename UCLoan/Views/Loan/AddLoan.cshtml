@using UCLoan.ViewModels.Loan
@model AddLoanViewModel

@{
    ViewData["Title"] = "Adicionar Empréstimo";

    var allAvailableEquipments = (IEnumerable<SelectListItem>)ViewBag.AllAvailableEquipments;
    var allPhysicalStatus = (IEnumerable<SelectListItem>)ViewBag.AllPhysicalStatus;

    if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="text-center mb-4">@ViewData["Title"]</h3>

                    <form asp-controller="Loan"
                          asp-action="AddLoan"
                          method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="form-floating mb-3">
                            <input asp-for="UserEmail" class="form-control" placeholder="E-mail do usuário que vai receber o equipamento" />
                            <label asp-for="UserEmail">E-mail *</label>
                            <span asp-validation-for="UserEmail" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Equipamento *</label>
                            <select asp-for="EquipmentId"
                                    asp-items="allAvailableEquipments"
                                    class="form-select">
                                <option value="">Selecione o equipamento</option>
                            </select>
                            <span asp-validation-for="EquipmentId" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="EndDate" class="form-control" type="date" placeholder="Insira a data de devolução" />
                            <label asp-for="EndDate">Devolução *</label>
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Description" class="form-control" placeholder="Insira a descrição do empréstimo" />
                            <label asp-for="Description">Descrição</label>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <button type="submit" class="w-100 btn btn-lg btn-primary">Salvar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

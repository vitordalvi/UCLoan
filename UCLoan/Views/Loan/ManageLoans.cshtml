@using UCLoan.Repositories
@model IEnumerable<UCLoan.Models.Loan>

@{
    ViewData["Title"] = "Gerenciar Empréstimos";
    var showAllLoanStatus = ViewBag.LoanStatusDisplay;
}

<link rel="stylesheet" href="https://cdn.datatables.net/2.3.4/css/dataTables.dataTables.css" />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="container">
    <div class="page-top">
        <h1>Lista de Empréstimos</h1>
        <a class="btn btn-primary"
           asp-controller="Home"
           asp-action="Index">
            Voltar
        </a>
        <a class="btn btn-primary"
           asp-controller="Loan"
           asp-action="AddLoan">
            Adicionar Empréstimo
        </a>
    </div>
    <table id="loansTable" class="table table-striped table-bordered align-middle text-lg-center">
        <thead class="table-dark">
            <tr>
                <th>ID do Empréstimo</th>
                <th>Usuário</th>
                <th>Equipamento</th>
                <th>Situação</th>
                <th>Início</th>
                <th>Devolução</th>
                <th>Descrição</th>
                <th class="text-center" style="width:180px;">Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var loan in Model)
                {
                    <tr>
                        <td>@loan.Id</td>
                        <td>@(loan.User?.Email ?? "Usuário não encontrado")</td>
                        <td>
                            @(
                                loan.Equipment?.EquipmentId != null
                                    ? $"{loan.Equipment.EquipmentId} - {loan.Equipment.EquipmentModel.Manufacturer} {loan.Equipment.EquipmentModel.Name}"
                                    : "Modelo não encontrado"
                            )
                        </td>
                        <td>@ViewBag.LoanStatusDisplay[(int)loan.LoanStatus]</td>
                        <td>@loan.StartDate.ToString("dd/MM/yyyy")</td>
                        <td>@(loan.EndDate.HasValue ? loan.EndDate.Value.ToString("dd/MM/yyyy") : "Não informado")</td>
                        <td>@loan.Description</td>
                        <td class="text-center">
                            <a class="btn btn-sm btn-primary"
                               asp-controller="Loan"
                               asp-action="EditLoan"
                               asp-route-id="@loan.Id">
                                Editar
                            </a>
                            <form asp-action="DeleteLoan"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Confirmar exclusão do modelo @loan.Id?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@loan.Id" />
                                <button type="submit" class="btn btn-sm btn-danger">Excluir</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-danger">Nenhum modelo foi encontrado!</td>
                </tr>
            }
        </tbody>
    </table>
</div>


@section Scripts {

    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.bootstrap5.js"></script>
    <script>
        $(document).ready(function () {
            $('#loansTable').DataTable({
                paging: true,
                searching: true,
                ordering: true,
                info: true,
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.5/i18n/pt-BR.json"
                }
            });
        });
    </script>
}
@using Microsoft.AspNetCore.Identity
@using UCLoan.ViewModels.Home
@model IndexViewModel
@inject UserManager<ApplicationUser> UserManager;
@inject SignInManager<ApplicationUser> SignInManager;

@{
    ViewData["Title"] = "Dashboard";
    var user = await UserManager.GetUserAsync(User);
}

@{
    if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
}

<h1 class="fw-bold text-dark mb-5">@ViewData["Title"]</h1>
<div class="container">

    <!-------------- USUÁRIO & PERFIL -------------->

    <section class="mb-5 mt-4">
        <div class="row justify-content-center g-4">
            <div class="col-12 col-md-6">
                <div class="card text-white bg-info h-100 shadow">
                    <div class="card-header">Seus dados</div>
                    <div class="card-body">
                        <h5 class="card-title">E-mail: @Model.UserEmail</h5>
                        <h5 class="card-title">Telefone: @(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Não informado" : Model.PhoneNumber)</h5>
                        <p class="card-text">Eles são usados para registro de empréstimos.</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="card text-white bg-info h-100 shadow">
                    <div class="card-header">Seu Perfil</div>
                    <div class="card-body">
                        <h5 class="card-title">Seu cargo: @Model.Role</h5>
                        <h5 class="card-title">CPF: @Model.CPF</h5>
                        <p class="card-text">Você já está elegível à um empréstimo.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-------------- EMPRÉSTIMOS, DATAS E EQUIPAMENTOS -------------->

    <!---- Se a ViewModel tiver algum equipamento ativo, libera outra seção ---->
    @if (Model.ActiveLoans > 0)
    {
        <section class="mb-5 mt-4">
            <div class="row justify-content-center g-4">
                <div class="col-12 col-md-4">
                    <div class="card text-white bg-info h-100 shadow">
                        <div class="card-header">Empréstimos</div>
                        <div class="card-body">
                            <h5 class="card-title mt-xl-3">Empréstimos: @Model.ActiveLoans</h5>
                            <h5 class="card-title">ID: @(Model.LoanId <= 0 ? "N/A" : Model.LoanId)</h5>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card text-white bg-info h-100 shadow">
                        <div class="card-header">Datas do Empréstimo</div>
                        <div class="card-body">
                            <h5 class="card-title mt-xl-3">
                                Início: @(Model.LoanStartDate.HasValue
                                    ? Model.LoanStartDate.Value.ToString("dd/MM/yyyy")
                                    : "N/A")
                            </h5>
                            <h5 class="card-title mt-xl-3">
                                Final: @(Model.LoanEndDate.HasValue
                                    ? Model.LoanEndDate.Value.ToString("dd/MM/yyyy")
                                    : "N/A")
                            </h5>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card text-white bg-info h-100 shadow">
                        <div class="card-header">Equipamentos</div>
                        <div class="card-body">
                            <h5 class="card-title mt-xl-3">Equipamento: @Model.EquipmentManufacturer @Model.EquipmentName</h5>
                            <h5 class="card-title">ID: @(Model.EquipmentId <= 0 ? "N/A" : Model.EquipmentId)</h5>
                            <h5 class="card-title">Estado físico: @(Model.EquipmentPhysicalStatus)</h5>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }
</div>

@using UCLoan.Repositories
@model IEnumerable<UCLoan.Models.Queue>

@{
    ViewData["Title"] = "Gerenciar Fila";

}

<link rel="stylesheet" href="https://cdn.datatables.net/2.3.4/css/dataTables.dataTables.css" />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="container">
    <div class="page-top">
        <h1>Fila de Empréstimos</h1>
        <a class="btn btn-primary"
           asp-controller="Home"
           asp-action="Queue">
            Visão de Usuário
        </a>
        <a class="btn btn-primary"
           asp-controller="Admin"
           asp-action="Users">
            Gerenciar Usuários
        </a>
    </div>
    <table id="queueTable" class="table table-striped table-bordered align-middle text-lg-center justify-content-between">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>E-mail</th>
                <th>Motivo</th>
                <th>Data da Requisição</th>
                <th class="text-center" style="width:180px;">Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var queue in Model)
                {
                    <tr>
                        <td>@queue.Id</td>
                        <td>@queue.User?.Email</td>
                        <td>@queue.Description</td>
                        <td>@queue.CreatedAt.ToString("dd/MM/yyy")</td>
                        <td class="text-center">
                            <a class="btn btn-sm btn-primary"
                               asp-controller="Loan"
                               asp-action="TakeOutRequest"
                               asp-route-id="@queue.Id">
                                Realizar
                            </a>
                            <form asp-action="DeleteRequest"
                                  asp-controller="Home"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Recusar o pedido @queue.Id?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@queue.Id" />
                                <button type="submit" class="btn btn-sm btn-danger">Recusar</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-danger">Nenhum equipamento foi encontrado!</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {

    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.bootstrap5.js"></script>
    <script>
        $(document).ready(function () {
            $('#queueTable').DataTable({
                paging: true,
                searching: true,
                ordering: true,
                info: false,
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.5/i18n/pt-BR.json"
                }
            });
        });
    </script>
}
@using Microsoft.AspNetCore.Identity
@using UCLoan.ViewModels.Admin
@model IndexViewModel
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

@{
    ViewData["Title"] = "Dashboard Admin";
}

<div class="container mt-4">
    <h1 class="fw-bold text-danger text-opacity-75">@ViewData["Title"]</h1>
    <a class="btn btn-outline-primary"
       asp-controller="Home"
       asp-action="Index">
        Visão de Usuário
    </a>

    <!-------------- USUÁRIOS -------------->

    <section class="mb-5 mt-3">
        <h2 class="mb-4">Usuários</h2>
        <div class="row g-4">
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card text-white bg-info h-100 shadow">
                    <div class="card-header">Usuários Cadastrados</div>
                    <div class="card-body">
                        <h5 class="card-title">@Model.TotalUsers</h5>
                        <p class="card-text">Usuários cadastrados no sistema.</p>
                        <a class="btn btn-outline-light btn-sm"
                           asp-controller="Admin"
                           asp-action="Users">
                            Mais informações
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card text-white bg-info h-100 shadow">
                    <div class="card-header">Administradores</div>
                    <div class="card-body">
                        <h5 class="card-title">@Model.TotalAdmins</h5>
                        <p class="card-text">Administradores cadastrados no sistema.</p>
                        <a class="btn btn-outline-light btn-sm"
                           asp-controller="Admin"
                           asp-action="Users">
                            Mais informações
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card text-white bg-info h-100 shadow">
                    <div class="card-header">Usuários Cadastrados</div>
                    <div class="card-body">
                        <h5 class="card-title">@Model.NewUsers</h5>
                        <p class="card-text">Usuários cadastrados no sistema.</p>
                        <a class="btn btn-outline-light btn-sm"
                           asp-controller="Admin"
                           asp-action="Users">
                            Mais informações
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-------------- EQUIPAMENTOS --------------> 
    <section class="mb-5">
        <h2 class="mb-4">Equipamentos</h2>

        <div class="row g-4">
            <!-- Card 1 -->
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card text-white bg-primary h-100 shadow">
                    <div class="card-header">Equipamentos Cadastrados</div>
                    <div class="card-body">
                        <h5 class="card-title">@Model.AllEquipments</h5>
                        <p class="card-text">Equipamentos cadastrados no sistema.</p>
                        <a class="btn btn-outline-light btn-sm"
                           asp-controller="Equipment"
                           asp-action="ManageEquipments">
                            Mais informações
                        </a>
                    </div>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card text-white bg-warning h-100 shadow">
                    <div class="card-header">Equipamentos Emprestados</div>
                    <div class="card-body">
                        <h5 class="card-title">@Model.LoanedEquipments</h5>
                        <p class="card-text">Equipamentos atualmente em uso.</p>
                        <a class="btn btn-outline-light btn-sm"
                           asp-controller="Loan"
                           asp-action="Index">
                            Mais informações
                        </a>
                    </div>
                </div>
            </div>

            <!-- Card 3 (exemplo adicional) -->
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card text-white bg-danger h-100 shadow">
                    <div class="card-header">Equipamentos em Manutenção</div>
                    <div class="card-body">
                        <h5 class="card-title">@Model.MaintanceEquipments</h5>
                        <p class="card-text">Equipamentos atualmente em manutenção.</p>
                        <a class="btn btn-outline-light btn-sm"
                           asp-controller="Equipment"
                           asp-action="ManageEquipments">
                            Mais informações
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-------------- EMPRÉSTIMOS -------------->
    <section class="mb-5">
        <h2 class="mb-4">Equipamentos</h2>

        <div class="row g-4">
            <!-- Card 1 -->
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card text-white bg-primary h-100 shadow">
                    <div class="card-header">Empréstimos Cadastrados</div>
                    <div class="card-body">
                        <h5 class="card-title">@Model.TotalLoans</h5>
                        <p class="card-text">Empréstimos totais no sistema.</p>
                        <a class="btn btn-outline-light btn-sm"
                           asp-controller="Loan"
                           asp-action="Index">
                            Mais informações
                        </a>
                    </div>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card text-white bg-warning h-100 shadow">
                    <div class="card-header">Empréstimos ativos</div>
                    <div class="card-body">
                        <h5 class="card-title">@Model.CurrentLoans</h5>
                        <p class="card-text">Empréstimos em atividade.</p>
                        <a class="btn btn-outline-light btn-sm"
                           asp-controller="Loan"
                           asp-action="Index">
                            Mais informações
                        </a>
                    </div>
                </div>
            </div>

            <!-- Card 3 (exemplo adicional) -->
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card text-white bg-danger h-100 shadow">
                    <div class="card-header">Empréstimos atrasados</div>
                    <div class="card-body">
                        <h5 class="card-title">@Model.MaintanceEquipments</h5>
                        <p class="card-text">Empréstimos que estão em atraso.</p>
                        <a class="btn btn-outline-light btn-sm"
                           asp-controller="Loan"
                           asp-action="Index">
                            Mais informações
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

</div>

@model UCLoan.Models.ApplicationUser
@{
    ViewData["Title"] = "Gerenciar Perfil";
    var allRoles = (IEnumerable<string>)ViewBag.AllRoles;
    var userRoles = (IEnumerable<string>)ViewBag.UserRoles;

    var selectedRole = userRoles?.FirstOrDefault();
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="text-center mb-4">@ViewData["Title"]</h3>

                    <form asp-controller="Admin"
                          asp-action="EditUser"
                          method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                        <input type="hidden" asp-for="Id" />

                        <div class="form-floating mb-3">
                            <input asp-for="FullName" class="form-control" placeholder="Altere o nome do usuário" />
                            <label asp-for="FullName">Nome completo</label>
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Email" class="form-control" placeholder="Altere e-mail do usuário" />
                            <label asp-for="Email">E-mail</label>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="PhoneNumber" class="form-control" placeholder="Altere o número de telefone do usuário." />
                            <label asp-for="PhoneNumber">Telefone</label>
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="CPF" class="form-control" placeholder="Altere o CPF do usuário." />
                            <label asp-for="CPF">CPF</label>
                            <span asp-validation-for="CPF" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label for="roleSelect" class="form-label">Cargo do Usuário</label>
                            <select id="roleSelect" name="role" class="form-select">
                                @foreach (var role in allRoles)
                                {
                                    // Compara o cargo atual no loop com o cargo pré-selecionado (se houver)
                                    var isSelected = role.Equals(selectedRole, StringComparison.OrdinalIgnoreCase);
                                    <option value="@role" (isSelected ? "selected" : "")>@role</option>
                                }
                            </select>
                        </div>

                        <button type="submit" class="w-100 btn btn-lg btn-primary">Salvar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
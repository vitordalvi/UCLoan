@using UCLoan.Repositories
@model IEnumerable<UCLoan.Models.ApplicationUser>

@{
    ViewData["Title"] = "Gerenciar Usuários";
}

<link rel="stylesheet" href="https://cdn.datatables.net/2.3.4/css/dataTables.dataTables.css" />

<h1 class="mb-4">Lista de Usuários</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="table-responsive">
    <table id="usersTable" class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Nome completo</th>
                <th>CPF</th>
                <th>Email</th>
                <th>Telefone</th>
                <th class="text-center" style="width:180px;">Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var user in Model)
                {
                    <tr>
                        <td>@user.FullName</td>
                        <td>@user.CPF</td>
                        <td>@user.Email</td>
                        <td>@user.PhoneNumber</td>
                        <td class="text-center">
                            <a class="btn btn-sm btn-primary"
                               asp-controller="Admin"
                               asp-action="EditUser"
                               asp-route-id="@user.Id">
                                Editar
                            </a>

                            <form asp-action="DeleteUser"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Confirmar exclusão do usuário @user.Email ?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@user.Id" />
                                <button type="submit" class="btn btn-sm btn-danger">Excluir</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-danger">Nenhum usuário foi encontrado!</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/2.3.4/js/dataTables.js"></script>
<script>
    $(document).ready(function () {
        $('#usersTable').DataTable({
            paging: true,
            searching: true,
            ordering: true,
            info: true,
            language: {
                url: "//cdn.datatables.net/plug-ins/1.13.5/i18n/pt-BR.json"
            }
        });
    });
</script>
@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Configurar Autenticador";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div>
    <p class="pt-2">Para usar um aplicativo autenticador, siga os passos:</p>
    <ol class="list">
        <li>
            <p>
                Baixe um aplicativo autenticador como o Microsoft Authenticator para
                <a href="https://go.microsoft.com/fwlink/?Linkid=825072">Android</a> e
                <a href="https://go.microsoft.com/fwlink/?Linkid=825073">iOS</a> ou
                Google Authenticator para
                <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en">Android</a> e
                <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8">iOS</a>.
            </p>
        </li>
        <li>
            <p>Escaneie o QR Code ou use essa chave <kbd>@Model.SharedKey</kbd> no seu aplicativo de autenticação de dois fatores. Espaços e caracteres maiúsculos ou minúsculos não interferem.</p>
        </li>
        <li>
            <p>
                Assim que você tiver escaneado o QR Code ou inserido a chave a cima, o seu aplicativo de autenticação de dois fatores vai te disponibilizar
                um código único. Insira o código na caixa de confirmação abaixo.
            </p>
            <div class="row">
                <div class="col-md-6">
                    <form id="send-code" method="post">
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Code" class="form-control" autocomplete="off" placeholder="Insira o código."/>
                            <label asp-for="Input.Code" class="control-label form-label">Código de Verificação</label>
                            <span asp-validation-for="Input.Code" class="text-danger"></span>
                        </div>
                        <button type="submit" class="w-100 btn btn-lg btn-primary">Verificar</button>
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    </form>
                </div>
            </div>
        </li>
    </ol>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

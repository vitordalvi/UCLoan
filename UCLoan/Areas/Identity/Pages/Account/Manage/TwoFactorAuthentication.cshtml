@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Autenticação de dois Fatores (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
@{
    var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();
    @if (consentFeature?.CanTrack ?? true)
    {
        @if (Model.Is2faEnabled)
        {
            if (Model.RecoveryCodesLeft == 0)
            {
                <div class="alert alert-danger">
                    <strong>Você não tem mais códigos de verificação.</strong>
                    <p>Você deve <a asp-page="./GenerateRecoveryCodes">gerar novos códigos de verificação</a> antes de entrar com um outro código.</p>
                </div>
            }
            else if (Model.RecoveryCodesLeft == 1)
            {
                <div class="alert alert-danger">
                    <strong>Você tem um código de verificação restante.</strong>
                    <p>You can <a asp-page="./GenerateRecoveryCodes">gerar novos códigos de verificação</a>.</p>
                </div>
            }
            else if (Model.RecoveryCodesLeft <= 3)
            {
                <div class="alert alert-warning">
                    <strong>Você tem @Model.RecoveryCodesLeft códigos de verificação restantes.</strong>
                    <p>You should <a asp-page="./GenerateRecoveryCodes">gerar novos códigos de verificação</a>.</p>
                </div>
            }

            if (Model.IsMachineRemembered)
            {
                <form method="post" style="display: inline-block">
                    <button type="submit" class="btn btn-primary">Esquecer desse navegador</button>
                </form>
            }
            <a asp-page="./Disable2fa" class="btn btn-primary">Disable 2FA</a>
            <a asp-page="./GenerateRecoveryCodes" class="btn btn-primary">Resetar códigos de verificação</a>
        }

        <h5 class="mt-3">Aplicativo Autenticador</h5>
        @if (!Model.HasAuthenticator)
        {
            <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary">Adicionar Aplicativo Autenticador</a>
        }
        else
        {
            <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary">Adicionar Aplicativo Autenticador</a>
            <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="btn btn-primary">Resetar Aplicativo Autenticador</a>
        }
    }
    else
    {
        <div class="alert alert-danger">
            <strong>As políticas de privacidade e cookies não foram aceitas.</strong>
            <p>Você deve aceitar essas políticas antes de habilitar a autenticação de dois fatores.</p>
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

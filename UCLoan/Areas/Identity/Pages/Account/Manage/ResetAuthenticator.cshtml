@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Resetar chaves do Autenticador";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>Se você resetar a sua chave autenticadora, o aplicativo não vai funcionar até que seja configurado novamente.</strong>
    </p>
    <p>
        Esse processo desabilita a 2FA até você verificar o seu aplicativo autenticador. Se você não
        completar a configuração do seu aplicativo autenticador, você pode perder acesso a sua conta.
    </p>
</div>
<div>
    <form id="reset-authenticator-form" method="post">
        <button id="reset-authenticator-button" class="btn btn-danger" type="submit">Resetar Chave Autenticadora</button>
    </form>
</div>

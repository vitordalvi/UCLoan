@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Gerar códigos de recuperação da autenticação de dois fatores (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>Guarde esses códigos em um local seguro.</strong>
    </p>
    <p>
        Se você perder o seu dispositivo e não possuir os códigos, você pode perder o acesso a sua conta.
    </p>
    <p>
        Gerar novos códigos de recuperação não alteram as chaves utilizadas em aplicativos autenticadores. Se você deseja alterar as chaves
        usadas no aplicativo autenticador, você deve <a asp-page="./ResetAuthenticator">resetar as suas chaves autenticadoras.</a>
    </p>
</div>
<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">Gerar novos códigos de recuperação</button>
    </form>
</div>

@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirmar Registro";
}

<h1>@ViewData["Title"]</h1>
@{
    if (@Model.DisplayConfirmAccountLink)
    {
        <h4 class="mb-2 mt-5">Essa parte ainda está sendo desenvolvida ;)</h4>

        <a id="confirm-link" href="@Model.EmailConfirmationUrl"
           class="btn btn-lg btn-primary w-30 mt-3">
            Confirmar registro
        </a>

    }
    else
    {
        <p>
            Por favor, cheque seu e-mail para verificar sua conta.
        </p>
    }
}